{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions\\.json$/"
      ],
      "matchStrings": [
        "\"studio_console\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "selfhosthub/studio-console",
      "datasourceTemplate": "github-releases"
    }
  ]
}