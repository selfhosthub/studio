# .dockerignore (repo root)
# Applied when build context is the repo root — governs both:
#   Dockerfile        (core: ui + api + general/transfer workers)
#   Dockerfile.full   (full: above + postgres)
# NOTE: per-directory .dockerignore files (ui/, api/, workers/) do NOT apply
# at root context, so build cruft must be re-excluded here.

# --- VCS ---
.git
.gitignore
.gitmodules

# --- CodeQL scan artifacts ---
**/*.sarif
**/*-codeql-db/
**/.codeql/

# --- Node (ui/) ---
**/node_modules
**/.next
**/out
**/.swc
**/.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Python (api/, workers/) ---
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/*.pyo
**/*.egg-info
**/*.egg
**/.pytest_cache
**/.coverage
**/.coverage.*

# --- Env files (never built in; only envs/.env.prod ships, separately) ---
**/.env
**/.env.local
**/.env.*.local

# --- Tests ---
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# --- OS / IDE ---
**/.DS_Store
Thumbs.db
.vscode
.idea
*.swp
*.swo

# --- Build artifacts / backups ---
*.tar
*.tar.gz
**/build
**/dist
**/*.bak
**/*.old
**/*.backup

# --- Docker (self) ---
Dockerfile
Dockerfile.full
.dockerignore
