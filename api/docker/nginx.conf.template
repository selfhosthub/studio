# api/docker/nginx.conf.template
# Front-door reverse proxy for the single-image shapes (core/full).
# api and ui are local processes under the same supervisord; nginx fronts
# them on one listen port so the browser, SSR, and cloudflared all use a
# single origin. Same routing as the split-stack template (deploy/nginx),
# but upstreams are fixed at localhost since there is exactly one of each.
# ${SHS_NGINX_PORT} and ${SHS_API_HOSTNAME} are substituted by
# nginx-start.sh (envsubst) at boot.

worker_processes 1;
pid /var/run/nginx/nginx.pid;
error_log /var/log/supervisor/nginx_error.log warn;

events {
    worker_connections 1024;
}

http {
    access_log off;

    # WebSocket connection upgrade map (referenced below).
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    upstream studio_api {
        server 127.0.0.1:8000;
    }

    upstream studio_ui {
        server 127.0.0.1:3000;
    }

    server {
        listen ${SHS_NGINX_PORT};

        # nginx's own liveness, independent of upstreams.
        location /nginx-health {
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }

        # API health check (top-level route, not under /api).
        location = /health {
            proxy_pass http://studio_api;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Worker control endpoints never go through the front door; native
        # same-host workers use the localhost-published API port instead.
        location ^~ /internal/ {
            return 404;
        }

        location ^~ /api/v1/internal/ {
            return 404;
        }

        # API + WebSocket traffic.
        location ~ ^/(api|ws)(/|$) {
            proxy_pass http://studio_api;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # UI (everything else).
        location / {
            proxy_pass http://studio_ui;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # API hostname: every path routes to the API, including /internal/*, so
    # remote workers reach worker control endpoints via this hostname. When
    # SHS_API_HOSTNAME is unset the server_name never matches a real Host.
    server {
        listen ${SHS_NGINX_PORT};
        server_name ${SHS_API_HOSTNAME};

        location /nginx-health {
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }

        location / {
            proxy_pass http://studio_api;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }
    }
}
