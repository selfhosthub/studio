.env
.env.*
envs/

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation
README.md
TESTING.md
docs/

# Misc
.prettierrc
.prettierignore
.eslintrc.json
jest.config.js
jest.setup.js

# Cache
.swc
cache

# Backup files
backup/
*.backup
*.bak
*.old

# Analysis files
combined_code.txt
full_app_analysis.txt

# Docker
Dockerfile
.dockerignore
